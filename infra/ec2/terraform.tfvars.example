# Copy to terraform.tfvars (ignored by Git), then review docs/DEPLOYMENT.md.
# This template does not unlock provisioning or promise a zero-dollar bill.
region           = "ap-south-1"
instance_type    = "t3.small"
root_volume_size = 20

# Leave false until the account plan, remaining credits, expiry, regional
# eligibility and estimated EC2 + gp3 + public IPv4 cost have been verified.
# This is an operator acknowledgement, not an automatic spending cap.
credit_plan_confirmed = false
